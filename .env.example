# Example configuration file for TinyAgent
# Copy this file to .env and fill in your keys: cp .env.example .env

# Cloud LLM Providers (OpenAI-compatible)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# General fallback key
LLM_API_KEY=your_general_api_key_here

# Optional: Override base URL (defaults to http://localhost:11434/v1 for local Ollama)
# LLM_BASE_URL=http://localhost:11434/v1
